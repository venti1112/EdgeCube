<?xml version="1.0" encoding="utf-8"?>
<!--
  EdgeCube 桌面小组件布局：胶囊形（左圆点 + 实例名 / 玩家数 / 地址 + 启停按钮）。
  背景圆角与颜色由 widget_background drawable 提供；文字与按钮颜色在渲染时
  按用户外观设置动态覆盖。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="@drawable/widget_background">

    <!-- 状态点：随状态变色，运行=绿、忙碌=橙、停止=灰 -->
    <ImageView
        android:id="@+id/widget_dot"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/widget_dot_running" />

    <!-- 信息区：实例名 / 玩家数 / 公网地址 / CPU·MEM；按用户勾选项动态拼接显示 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="start|center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EdgeCube"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:maxWidth="220dp" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:maxWidth="240dp"
            android:includeFontPadding="false" />

    </LinearLayout>

    <!-- 启停按钮：运行中显示停止图标，停止/忙碌中显示启动图标 -->
    <ImageView
        android:id="@+id/widget_action_button"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:padding="6dp"
        android:src="@drawable/widget_button_start"
        android:contentDescription="@string/widget_action_start" />

</LinearLayout>
